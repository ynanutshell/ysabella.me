{
  "name": "ysabella.me",
  "version": "0.3.0",
  "description": "Personal site and playground of Ysabella Nicole Alvarez, product designer and aspiring technologist.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "rsync -av --delete --exclude='.obsidian/' --exclude='plugins/' --exclude='templates/' --include='*/' --include='*.md' --exclude='*' \"$GARDEN_PATH/\" src/content/garden/",
    "prebuild": "git rev-parse --short HEAD > src/commit.txt",
    "watch": "fswatch -o \"$GARDEN_PATH/\" | xargs -I{} sh -c 'npm run sync'",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "lottie-web": "^5.13.0",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.4",
    "remark-callout": "^1.1.1",
    "remark-code-titles": "^0.1.2",
    "remark-reference-links": "^7.0.0",
    "remark-sectionize": "^2.1.0",
    "remark-smartypants": "^3.0.2",
    "remark-wiki-link": "^2.0.1",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260708.1": true
  }
}
