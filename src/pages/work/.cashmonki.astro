---
import Layout from '../../layouts/WorkLayout.astro';

const meta = {
  title: "Designed a budget management feature with an adoption rate of one-third of active users – ysabella",
  description: "Studies have shown that 60% of people don’t really know how much they spent the month before. In this study, Ysabella explores implementing a feature that provides users with more insight and clarity into their spending habits.",
  ogImage: '/opengraph.png',
};

const data = {
  status: 'shipped' as const,
  headline: "Designed a budget management feature with an adoption rate of one-third of active users.",
  subline: "Studies have shown that 60% of people don’t really know how much they spent the month before. In this study, I explored implementing a feature that provides users with more insight and clarity into their spending habits.",
  type: "project" as const,
  tags: ["Product design"],
  image: { 
    type: 'lottie' as const,
    src: '/assets/cashmonki.json',
    loop: true,
    autoplay: true, 
  },
  metadata: [
    { label: "Product", value: "iOS mobile application" },
    { label: "Role", value: "Product designer"},
    { label: "Timeline", value: ["November 2025 -", "December 2025"]},
    { label: "Contribution", value: ["Product design", "Market research", "Feature development"] }
  ],
  subheadings: [
    { depth: 2, text: "overview", slug: "overview" },
    { depth: 2, text: "challenge", slug: "challenge" },
    { depth: 2, text: "problem", slug: "problem" },
    { depth: 2, text: "research", slug: "research" },
    { depth: 2, text: "testing", slug: "testing" },
  ]
}

---
<Layout meta={meta} data={data} >
  <section id="overview">
    <h3 class="caption label">Overview</h3>
    <h2 class="title">Cashmonki was first introduced as an expense tracker with a twist.</h2>
    <p>Users can add and track transactions manually or automatically through AI-powered receipt scanning. This low-friction experience set Cashmonki apart from other personal finance tools, but insights were otherwise limited.</p>
  </section>
  <section id="challenge">
    <h3 class="caption label">Challenge</h3>
    <h2 class="title">Next on the agenda was a budget management feature.</h2>
    <p>As someone who has tracked personal expenses across spreadsheets and apps, I’ve found that seeing past transactions rarely leads to better financial decisions on its own.</p>
    <p>The next step was a budget management feature, to move beyond tracking past activity and enable users to plan ahead.</p>
  </section>
  <section id="problem">
    <h3 class="caption label">Problem</h3>
    <h2 class="title">But what does it mean to set a budget?</h2>
    <p>While mapping out the specifications for this feature, I realized that "budget management" meant something else to each person. For example, my team lead prefers to focus on short-term, goal-based budgets, whereas I’m more interested in long-term spending patterns.</p>
  </section>
  <section id="research">
    <h3 class="caption label">Research</h3>
    <h2 class="title">Similar apps don't offer flexibility</h2>
    <p>A competitive analysis revealed that most budgeting features were locked into monthly cycles, offering little to no flexibility. I wanted users to define budgets on their own terms: daily, weekly, or long-term.</p>
  </section>
  <section id="testing">
    <h3 class="caption label">Testing</h3>
    <h2 class="title">Iterate, iterate, iterate...</h2>
  </section>
</Layout>