---
import { getCollection } from 'astro:content';
// import Filter from '../../components/Filter.astro';
import ArrowLeftIcon from '../../components/icons/ArrowLeft.astro';
import Layout from '../../layouts/BaseLayout.astro';
// import LinkButton from '../../components/LinkButton.astro';
import Writings from '../../sections/writing.astro';

const entries = await getCollection('garden');

const request = Astro.request;
const url = new URL(request.url);
const active = url.searchParams.get('type') || url.searchParams.get('filter') || undefined;

const items = entries
  .filter(e => e.data.published !== false && e.data.type !== 'bookmark')
  .filter(e => !active || [e.data.type, e.data.subtype].filter(Boolean).includes(active))
  .sort((a, b) => (b.data.planted?.getTime() ?? 0) - (a.data.planted?.getTime() ?? 0));

const metadata = {
  title: `writing - ysabella nicole alvarez`,
  description: "A collection of (likely unfinished) notes, thoughts, and explorations Ysabella is slowly tending to over time.",
  ogImage: '/opengraph.png'
};

/* const filterMap = [
  { label: 'notes', value: 'notes' },
  { label: 'ideas', value: 'ideas' },
  { label: 'thoughts', value: 'thoughts' },
  { label: 'til', value: 'til' },
];

const filters = filterMap.map(f => ({
  label: f.label,
  value: f.value,
  count: entries.filter(e => (e.data.type === f.value || e.data.subtype === f.value) && e.data.published !== false).length,
})); */
---
<Layout {...metadata} classes="text" activeTab="garden">
  <header class="column sm">
    <h1>Sometimes, I Write.</h1>
    <div class="subline">
      <p>This space is a continuous work-in-progress that I’m hoping to keep updated with anything from personal reflections, things I’m learning about, and early ideas.</p>
    </div>
  </header>
  {entries.length > 0 && (
    <section class="column sm" id="writing">
      <div class="row stretch apart">
        <a class="noborder caption label back-link" aria-label="Back" href="/garden" data-back-link>
          <ArrowLeftIcon />
          Back
        </a>
        <!-- <LinkButton aria-label="Back" class="back-link" href="/garden">
          <ArrowLeftIcon />
          <span>back to garden</span>
        </LinkButton>
        <Filter filters={filters} active={active} /> -->
      </div>
      {items.length > 0 && (
        <Writings entries={items} limit={8} />
      )}
    </section>
  )}
</Layout>

<script>
  const backLink = document.querySelector('[data-back-link]');
  if (backLink && document.referrer) {
    backLink.setAttribute('href', document.referrer);
    console.log(document.referrer);
  }

  backLink?.addEventListener('click', (e) => {
    if (window.history.length > 1 && document.referrer) {
      e.preventDefault();
      window.history.back();
    }
  });
</script>