---
import { getPageMetadata } from '../utils/seo';
import Layout from '../layouts/BaseLayout.astro';

const metadata = getPageMetadata('about');
---
<Layout {...metadata} classes="text" activeTab="about">
  <header class="column sm">
    <h1>Hi, I'm Ysabella.</h1>
    <div class="subline">
      <p>I’m a product designer and aspiring technologist with a deep-rooted interest in digital spaces–from the day I first booted up a computer, to roaming questionable, online worlds at an all-too-young age, to carving out my own slice of the internet on BlogSpot, custom MySpace pages, and restyled forum board themes.</p>
      <p>The work I make sits between pixels, interaction, and storytelling; my goal is to craft thoughtful experiences that spark child-like curiosity and whimsy along the way. I hope that reflects in this space, as both a showcase of my work and my personal playground.</p>
      <p>When I’m not working, I’m playing video games that won't trigger my motion sickness, trying my hand at photography, cycling through bustling city streets, or petting the local neighborhood cats.</p>
    </div>
  </header>
  <div class="column lg">
    <section class="row" id="experience">
      <h2 class="title italic">Experience</h2>
      <ul class="stretch">
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Product Design</span>
              <span>@</span>
              <span>Rosebud Studio</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2024-2026</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Graphic Design</span>
              <span>@</span>
              <span>Standard Hospitality</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2023-2024</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Visual Design</span>
              <span>@</span>
              <span>Frost Design Group</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2022-2023</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Digital Design</span>
              <span>@</span>
              <span>AMAGI</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2019-2021</span>
          </div>
        </li>
      </ul>
    </section>
    <section class="row" id="projects">
      <h2 class="title italic">Projects</h2>
      <ul class="stretch">
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Research Operations</span>
              <span>@</span>
              <span>Curiosity</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2022-</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Product Design</span>
              <span>@</span>
              <span>Plasmic</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2026</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Web Management</span>
              <span>@</span>
              <span>Grid Magazine</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2023-2024</span>
          </div>
        </li>
      </ul>
    </section>
    <section class="row" id="recognition">
      <h2 class="title italic">Recognition</h2>
      <ul class="stretch">
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">UI/UX Showcase</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2026</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Footer Design</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2026</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Navbar Gallery</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2026</span>
          </div>
        </li>
      </ul>
    </section>
    <section class="row" id="misc">
      <h2 class="title italic">Misc.</h2>
      <ul class="stretch">
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Game Design</span>
              <span>@</span>
              <span>Bad Game Jam</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2025</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Community Builder</span>
              <span>@</span>
              <span>Esteban Cycling Club</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2023-2025</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Graphic Design</span>
              <span>@</span>
              <span>12 Stops of Christmas</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2023-2024</span>
          </div>
        </li>
        <li class="stretch">
          <div class="item row stretch">
            <div class="caption label">
              <span class="emphasis">Storyteller</span>
              <span>@</span>
              <span>Armageddon MUD</span>
            </div>
            <span class="divider stretch" aria-hidden="true" />
            <span class="caption label">2023-2024</span>
          </div>
        </li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .title {
    width: 16ch;
  }
  
  .row {
    align-items: flex-start;
    row-gap: var(--size-padding-xs);
  }

  ul {
    width: 100%;
    margin: unset;
  }

  li {
    width: 100%;
    margin: unset;

    + li {
      margin-top: var(--size-padding-md);
    }

    div {
      margin: unset;
    }
  }

  .item.row {
    display: inline-flex;
    vertical-align: middle;
  }

  .divider {
    flex-grow: 1;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    section {
      flex-direction: column;
    }

    ul {
      list-style-type: none;
    }

    li + li {
      margin-top: var(--size-padding-sm);
    }

    .caption.label {
      font-size: var(--size-type-small);
    }
  }
</style>