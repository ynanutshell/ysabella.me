<style is:global>
  /* Portrait Card */ 
  #portrait {
    display: flex;
    position: absolute;
    bottom: 92%;
    left: -10%;
    width: 12.5em;
    max-width: 40%;
    padding: var(--size-padding-lg);
    background-color: var(--color-primary-fg);
    transform: rotate3d(0,0,1,-6deg);
    z-index: 1;
  }

  #portrait svg {
    width: 100%;
    height: auto;
    color: var(--color-primary-bg);
  }

  #dialogue {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 110%;
    width: 100%;
    max-width: 25ch;
    transform: rotate3d(0, 0, 1, 6deg);

    * {
      color: var(--color-primary-highlight);
    }
    
    #message {
      padding-left: var(--size-padding-sm);
      text-align: left;
      text-wrap: pretty;
    }
  }

  #portrait:hover {
    #dialogue {
      display: block;
    }
  }

  @media (max-width: 768px) {
    #portrait {
      position: relative;
      left: 4%;
    }
  }

  /* Title Card */ 
  #title {
    display: flex;
    flex-direction: column;
    padding: var(--size-padding-xl);
    color: var(--color-secondary-fg);
    background-color: var(--color-secondary-bg);
    transform: rotate3d(0,0,1,2deg);

    h1 {
      font-size: var(--size-heading-lg);
      text-align: center;
      color: inherit;
      line-height: 2.0;
    }

    span {
      color: var(--color-tertiary);
    }

    span:hover {
      background-color: var(--color-tertiary);
      color: var(--color-secondary-bg);
    }

    .stroke {
      width: 100%;
      opacity: 0.1;
      color: inherit;
    }
  }

  /* Status Card */
  #currently {
    top: 90%;
    right: -10%;
    transform: rotate3d(0, 0, 1, -12deg);
  }

  #currently:before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    border-width: 0 var(--size-padding-md) var(--size-padding-md) 0;
    border-style: solid;
    border-color: rgba(from var(--color-primary-fg) r g b / 0.6 ) var(--color-background-100);
  }

  @media (max-width: 768px) {
    #currently {
      top: 4%;
      right: 2%;
      transform: rotate3d(0, 0, 1, 8deg);
      z-index: 1;
    }
  }
</style>

<script>
  import { getErrorFromURL, showError } from '../utils/errors';

  const errorCode = getErrorFromURL();
  if (errorCode) {
    const messageEl = document.getElementById('message');
    const dialogue = document.getElementById('dialogue');
    const defaultMessage = messageEl?.textContent || '';
    
    if (messageEl && dialogue) {
      messageEl.textContent = showError(errorCode);
      messageEl.classList.add('error');
      dialogue.style.display = 'block';
    }

    // Trigger SVG animations
    (document.querySelector('#mouth animate') as SVGAnimateElement)?.beginElement();
    (document.querySelector('#brow-left animate') as SVGAnimateElement)?.beginElement();
    (document.querySelector('#brow-right animate') as SVGAnimateElement)?.beginElement();

    setTimeout(() => {
      window.history.replaceState({}, '', window.location.pathname);
      if (dialogue && messageEl) {
        dialogue.style.display = '';
        messageEl.textContent = defaultMessage;
        messageEl.classList.remove('error');
      }
      // Reset by removing and re-adding the elements
      document.querySelectorAll('#mouth, #brow-left, #brow-right').forEach(el => {
        const parent = el.parentNode;
        const clone = el.cloneNode(true);
        parent?.replaceChild(clone, el);
      });
    }, 10000);
  }
  
  function initEyeTracking() {
    const leftEye = document.getElementById('eye-left')!;
    const rightEye = document.getElementById('eye-right')!;
    const leftLid = document.getElementById('eyelid-left')!;
    const rightLid = document.getElementById('eyelid-right')!;

    // Store original styles
    const originalEyeOpacity = '1';
    const originalBrowTransform = 'translate(0, 0)';
    
    // Amount brows move down during blink (in pixels)
    const browBlinkOffsetY = 32;

    let isBlinking = false;
    let blinkTimeout: ReturnType<typeof setTimeout> | null = null;

    function blink() {
      if (isBlinking) return;
      isBlinking = true;

      // Hide eyes and lower brows
      leftEye.style.opacity = '0';
      rightEye.style.opacity = '0';
      leftLid.style.transform = `translate(0, ${browBlinkOffsetY}px)`;
      rightLid.style.transform = `translate(0, ${browBlinkOffsetY}px)`;
      leftLid.style.transition = 'transform 0.02s ease-out';
      rightLid.style.transition = 'transform 0.02s ease-out';

      // Re-open after short delay
      blinkTimeout = setTimeout(() => {
        leftEye.style.opacity = originalEyeOpacity;
        rightEye.style.opacity = originalEyeOpacity;
        leftLid.style.transform = originalBrowTransform;
        rightLid.style.transform = originalBrowTransform;
        leftLid.style.transition = 'transform 0.1s ease-out';
        rightLid.style.transition = 'transform 0.1s ease-out';
        isBlinking = false;
      }, 120);
    }

    // Random blinking every 2-5 seconds
    function scheduleNextBlink() {
      const delay = 2000 + Math.random() * 3000;
      setTimeout(() => {
        blink();
        scheduleNextBlink();
      }, delay);
    }

    // Start blink cycle
    scheduleNextBlink();

    // Get each eye's bounding box once (and update on resize)
    let leftCenter = { x: 0, y: 0 };
    let rightCenter = { x: 0, y: 0 };
    const maxPupilOffset = 16; // how many pixels the pupil can shift

    if (!leftEye || !rightEye) return;

    function updateEyeCenters() {
      const leftBounds = leftEye.getBoundingClientRect();
      const rightBounds = rightEye.getBoundingClientRect();
      
      leftCenter = {
        x: leftBounds.left + leftBounds.width / 2,
        y: leftBounds.top + leftBounds.height / 2,
      };
      rightCenter = {
        x: rightBounds.left + rightBounds.width / 2,
        y: rightBounds.top + rightBounds.height / 2,
      };
    }

    updateEyeCenters();
    window.addEventListener('resize', updateEyeCenters);

    document.addEventListener('mousemove', (e) => {
      const mouseX = e.clientX;
      const mouseY = e.clientY;

      // Calculate offset for left eye
      const leftDx = mouseX - leftCenter.x;
      const leftDy = mouseY - leftCenter.y;
      const leftDist = Math.sqrt(leftDx * leftDx + leftDy * leftDy) || 1;
      const leftScale = Math.min(leftDist, 200) / 200; // clamp influence distance
      const leftOffsetX = (leftDx / leftDist) * maxPupilOffset * leftScale;
      const leftOffsetY = (leftDy / leftDist) * maxPupilOffset * leftScale;

      // Calculate offset for right eye
      const rightDx = mouseX - rightCenter.x;
      const rightDy = mouseY - rightCenter.y;
      const rightDist = Math.sqrt(rightDx * rightDx + rightDy * rightDy) || 1;
      const rightScale = Math.min(rightDist, 200) / 200;
      const rightOffsetX = (rightDx / rightDist) * maxPupilOffset * rightScale;
      const rightOffsetY = (rightDy / rightDist) * maxPupilOffset * rightScale;

      // Apply transform to each pupil
      leftEye.style.transform = `translate(${leftOffsetX}px, ${leftOffsetY}px)`;
      leftEye.style.transition = 'transform 0.08s ease-out';
      
      rightEye.style.transform = `translate(${rightOffsetX}px, ${rightOffsetY}px)`;
      rightEye.style.transition = 'transform 0.08s ease-out';
    });
  }

  // Run after DOM is ready
  document.addEventListener('DOMContentLoaded', initEyeTracking);
  // Also handle Astro's view transitions (if used)
  document.addEventListener('astro:page-load', initEyeTracking);
</script>