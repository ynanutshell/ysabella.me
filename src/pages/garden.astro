---
import { getCollection } from 'astro:content';
import { getPageMetadata } from '../utils/seo';
import ArrowRightIcon from '../components/icons/ArrowRight.astro';
import Layout from '../layouts/BaseLayout.astro';
import Writings from '../sections/writing.astro';
import Links from '../sections/links.astro';

const metadata = getPageMetadata('garden');
const entries = await getCollection('garden');
const published = entries.filter(entry => entry.data.published !== false);
const writing = published.filter(entry => entry.data.type !== 'bookmark' || !entry.data.type);
const bookmarks = published.filter(entry => entry.data.type === 'bookmark');
---
<Layout {...metadata} classes="text" activeTab="garden">
  <header class="column sm">
    <h1>The Garden.</h1>
    <div class="subline">
      <p>A digital garden is an unstructured collection of thoughts, ideas, and unfinished drafts that is continuously tended to in public with the intent of thinking out loud, sharing process, and documenting growth over time.</p>
      <p>Ironically, the only plant I’ve barely managed to keep alive is a pencil cactus.</p>
    </div>
  </header>
  {writing.length > 0 && (
    <section class="column xs" id="writing">
      <h2><a class="noborder caption label" href="/writing">
        Writing
        <ArrowRightIcon />
      </a></h2>
      <Writings entries={writing.slice(0, 5)} />
    </section>
  )}
  {bookmarks.length > 0 && (
    <section class="column xs" id="bookmarks">
      <h2><a class="caption label noborder" href="/bookmarks">
        <span>Bookmarks</span>
        <ArrowRightIcon />
      </a></h2>
      <Links entries={bookmarks.slice(0, 10)} />
    </section>
  )}
</Layout>