---
import { getCollection } from 'astro:content';
import ArrowLeftIcon from '../components/icons/ArrowLeft.astro';
import Layout from '../layouts/BaseLayout.astro';
// import LinkButton from '../components/LinkButton.astro';
import Links from '../sections/links.astro';

const entries = await getCollection('garden');
const published = entries.filter(entry => entry.data.published !== false);
const bookmarks = published.filter(entry => entry.data.type === 'bookmark');

const metadata = {
  title: `bookmarks - ysabella nicole alvarez`,
  description: "A log of things on the internet that Ysabella finds interesting—mostly for future reference, for when she inevitably has to hunt down an article, resource, or site from eons ago.",
  ogImage: '/opengraph.png'
};
---
<Layout {...metadata} classes="text" activeTab="garden">
  <header class="column sm">
    <h1>Things I Find Interesting.</h1>
    <div class="subline">
      <p>A log of things on the internet that I find interesting—mostly for future reference, for when I inevitably have to hunt down an article, resource, or site from eons ago.</p>
    </div>
  </header>
  {bookmarks.length > 0 && (
    <section class="column sm" id="bookmarks">
      <div class="row stretch apart">
        <a class="noborder caption label back-link" aria-label="Back" href="/garden" data-back-link>
          <ArrowLeftIcon />
          Back
        </a>
        <!-- <LinkButton type="back" href="/garden" aria-label="Back" class="back-link">
          <ArrowLeftIcon />
          <span>back</span>
        </LinkButton> -->
      </div>
      <Links entries={bookmarks.slice(0, 100)} />
    </section>
  )}
</Layout>

<script>
  const backLink = document.querySelector('[data-back-link]');
  if (backLink && document.referrer) {
    backLink.setAttribute('href', document.referrer);
    console.log(document.referrer);
  }

  backLink?.addEventListener('click', (e) => {
    if (window.history.length > 1 && document.referrer) {
      e.preventDefault();
      window.history.back();
    }
  });
</script>