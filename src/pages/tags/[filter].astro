---
import { getCollection } from 'astro:content';
import { getPageMetadata } from '../../utils/seo';
import ArrowLeftIcon from '../../components/icons/ArrowLeft.astro';
import Layout from '../../layouts/BaseLayout.astro';
import LinkButton from '../../components/LinkButton.astro';
import Writings from '../../sections/writing.astro';

export async function getStaticPaths() {
  const entries = await getCollection('garden');
  const allFilters = [...new Set(entries
    .filter(e => e.data.published !== false && e.data.type !== 'bookmark')
    .flatMap(e => [e.data.type, e.data.subtype, ...(e.data.tags || [])])
    .filter(Boolean))];

  return allFilters.map(filter => ({
    params: { filter },
    props: { filter },
  }));
}

const metadata = getPageMetadata('garden');
const entries = await getCollection('garden');
const { filter } = Astro.props;

const items = entries
  .filter(e => e.data.published !== false && e.data.type !== 'bookmark')
  .filter(e => e.data.type === filter || e.data.subtype === filter || e.data.tags?.includes(filter))
  .sort((a, b) => (b.data.planted?.getTime() ?? 0) - (a.data.planted?.getTime() ?? 0));
---
<Layout {...metadata} classes="text" activeTab="garden">
    <header class="column sm">
      <h1>Tags: <span class="emphasis">{filter[0].toUpperCase() + filter.slice(1)}</span> ({items.length})</h1>
    </header>
    {entries.length > 0 && (
      <section class="column sm" id="writing">
        <div class="row stretch apart">
          <LinkButton type="back" href="/writing" aria-label="Back" class="back-link">
            <ArrowLeftIcon />
            <span>back</span>
          </LinkButton>
        </div>
        {items.length > 0 && (
          <Writings entries={items} limit={4} />
        )}
      </section>
    )}
</Layout>

<style>
  h1 {
    color: var(--color-foreground-300);
  }
</style>

<script>
  const backLink = document.querySelector('[data-back-link]');
  if (backLink && document.referrer) {
    backLink.setAttribute('href', document.referrer);
    console.log(document.referrer);
  }
</script>