---
import '../styles/global.css';
import LinkButton from '../components/LinkButton.astro';
import TOC from '../components/TOC.astro';

export interface Props {
  meta: {
    title: string;
    description: string;
    ogImage?: string;
    slug?: string;
  };
  data: {
    headline: string;
    subline?: string;
    cover?: string;
    plantedDate: string;
    lastTendedDate: string;
    minRead: number;
    type?: string;
    subtype?: string;
    tags?: string[];
    subheadings?: { depth: number; text: string; slug: string }[];
  };
}

const { meta, data } = Astro.props;
const { title, description, ogImage } = meta;
const { headline, subline, cover, plantedDate, lastTendedDate, minRead, type, subtype, tags = [], subheadings = [] } = data;

const siteName = "ysabella nicole alvarez";
const siteURL = "https://www.ysabella.me";
const author = "Ysabella Nicole Alvarez";
const twitterHandle = "@ysabelladalawa";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    
    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="canonical" href={ new URL(Astro.url.pathname, siteURL).toString()} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={ new URL(Astro.url.pathname, siteURL).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteURL).toString()} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={title} />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:url" content={ new URL(Astro.url.pathname, siteURL).toString()} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, siteURL).toString()} />}
    {ogImage && <meta name="twitter:image:alt" content={title} />}
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    {import.meta.env.PROD && (

      <!-- Analytics -->
      <script 
        defer 
        src="https://analytics.ysabella.me/script.js" 
        data-website-id="717fb694-5754-4a02-83e7-31af6d33c492"
      ></script>
    )}
  </head>

  <body>
    <article>
      <nav id="top-nav">
          <LinkButton class="backlink" href="/garden">
            <svg class="arrow-left" width="9" height="7" viewBox="0 0 9 7" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.70715 3.35352H0.707153M3.70715 6.35352L0.707153 3.35352L3.70715 0.353516" stroke="#7D89B0"/>
            </svg>
            <span>back to garden</span>
          </LinkButton>
          {subheadings.length > 0 && (
            <TOC subheadings={subheadings} />
          )}
      </nav>
      <header class="column content">
        <dl class="metadata row">
          {plantedDate && (
            <div class="datapoint row">
              <dt class="item">Planted</dt>
              <dd class="small item emphasis">
                <time datetime={plantedDate}>
                  {new Date(plantedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </dd>
            </div>
          )}
          {lastTendedDate && (
            <span class="divider" aria-hidden="true" />
            <div class="datapoint row">
              <dt class="item">Last Tended</dt>
              <dd class="small item emphasis">
                <time datetime={lastTendedDate}>
                  {new Date(lastTendedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </dd>
            </div>
          )}
          <span class="divider" aria-hidden="true" />
          <div class="datapoint row">
            <dt class="item">{minRead} min read</dd>
          </div>
          </div>
        </dl>
        <div class="column content xs">
          <h1>{headline}</h1>
          {subline && (
            <p class="subline">{subline}</p>
          )}
        </div>
      </header>
      {cover && (
        <figure>
          <img src={cover} alt={title} />
        </figure>
      )}
      <div class="column sm content">
        <slot />
      </div>
      <dl class="metadata row">
          <div class="datapoint row">
            <dt class="item">Filed under</dt>
            <a class="small item emphasis" href={`/tags/${subtype || type || "notes"}`}>#{subtype || type || "notes"}</a>
          </div>
          {tags.map((tag) => (
            <a class="small item emphasis" href={`/tags/${tag}`}>#{tag}</a>
          ))}
        </dl>
      <nav id="bottom-nav">
        <LinkButton class="backlink" href="/garden">
            <svg class="arrow-left" width="9" height="7" viewBox="0 0 9 7" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.70715 3.35352H0.707153M3.70715 6.35352L0.707153 3.35352L3.70715 0.353516" stroke="#7D89B0"/>
            </svg>
            <span>back to garden</span>
          </LinkButton>
        <LinkButton class="scroll-top" aria-label="Scroll to top">scroll to top</LinkButton>
      </nav>
    </article>
  </body>
</html>

<style is:global>
  h2 {
    color: var(--color-foreground-300);
    font-family: var(--font-mono);
    font-size: var(--size-type-caption);
    text-transform: uppercase;
    letter-spacing: 8%;
  }

  h2:not(.callout-title h2), blockquote {
    margin-top: var(--size-padding-sm);
  }

  h3 {
    font-size: var(--size-heading-md);
  }
  
  img {
    max-height: 30rem;
    width: 100%;
  }
</style>

<script>
  const scrollTopBtn = document.querySelector('.scroll-top');
  if (scrollTopBtn) {
    window.addEventListener('scroll', () => {
      scrollTopBtn.classList.toggle('visible', window.scrollY > 300);
    });
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
