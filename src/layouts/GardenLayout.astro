---
import '../styles/global.css';
import Layout from '../layouts/BaseLayout.astro';
import LinkButton from '../components/LinkButton.astro';
import TOC from '../components/TOC.astro';

export interface Props {
  metadata: {
    title: string;
    description: string;
    ogImage?: string;
    slug?: string;
  };
  data: {
    headline: string;
    subline?: string;
    cover?: string;
    alt?: string;
    plantedDate: string;
    lastTendedDate: string;
    minRead: number;
    type?: string;
    subtype?: string;
    tags?: string[];
    subheadings?: { depth: number; text: string; slug: string }[];
  };
}

const { metadata, data } = Astro.props;
const { headline, subline, cover, alt, plantedDate, lastTendedDate, minRead, type, subtype, tags = [], subheadings = [] } = data;
---
<Layout {...metadata} activeTab="garden">
  <article class="text">
    <nav id="top-nav">
      <LinkButton class="backlink" href="/garden">
        <svg class="arrow-left" width="9" height="7" viewBox="0 0 9 7" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.70715 3.35352H0.707153M3.70715 6.35352L0.707153 3.35352L3.70715 0.353516" stroke="#7D89B0"/>
        </svg>
        <span>back to garden</span>
      </LinkButton>
      {subheadings.length > 0 && (
        <TOC subheadings={subheadings} />
      )}
    </nav>
    <header class="column content">
      <dl class="metadata row">
        {plantedDate && (
          <dl class="datapoint row">
            <dt class="item">Planted</dt>
            <dd class="small item emphasis">
              <time datetime={plantedDate}>
                {new Date(plantedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </dd>
          </dl>
        )}
        {lastTendedDate && (
          <span class="divider" aria-hidden="true" />
          <dl class="datapoint row">
            <dt class="item">Last Tended</dt>
            <dd class="small item emphasis">
              <time datetime={lastTendedDate}>
                {new Date(lastTendedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </dd>
          </dl>
        )}
        <span class="divider" aria-hidden="true" />
        <dl class="datapoint row">
          <dd class="small item">{minRead} min read</dd>
        </dl>
        </div>
      </dl>
      <div class="column content xs">
        <h1>{headline}</h1>
        {subline && (
          <p class="subline">{subline}</p>
        )}
      </div>
    </header>
    {cover && (
      <figure>
        <img src={cover} alt={alt} />
      </figure>
    )}
    <div class="column sm content">
      <slot />
    </div>
    <span class="divider stretch" aria-hidden="true" />
    <div class="row stretch apart">
      <dl class="datapoint row">
        <dt class="item">Filed under</dt>
        <dd><a class="small item emphasis" href={`/tags/${subtype || type || "notes"}`}>#{subtype || type || "notes"}</a></dd>
        {tags.map((tag) => (
        <dd><a class="small item emphasis" href={`/tags/${tag}`}>#{tag}</a></dd>
      ))}
      </dl>
    </div>
  </article>
</Layout>

<style is:global>
  h2 {
    color: var(--color-foreground-300);
    font-family: var(--font-mono);
    font-size: var(--size-type-caption);
    text-transform: uppercase;
    letter-spacing: 8%;
  }

  h2:not(.callout-title h2), blockquote {
    margin-top: var(--size-padding-sm);
  }

  h3 {
    font-size: var(--size-heading-md);
  }
  
  img {
    max-height: 30rem;
    width: 100%;
  }
</style>

<script>
  const scrollTopBtn = document.querySelector('.scroll-top');
  if (scrollTopBtn) {
    window.addEventListener('scroll', () => {
      scrollTopBtn.classList.toggle('visible', window.scrollY > 300);
    });
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
