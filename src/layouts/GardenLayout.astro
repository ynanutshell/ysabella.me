---
import '../styles/global.css';
import ArrowLeftIcon from '../components/icons/ArrowLeft.astro';
import ArrowUpIcon from '../components/icons/ArrowUp.astro';
import Layout from '../layouts/BaseLayout.astro';
import LinkButton from '../components/LinkButton.astro';
import TOC from '../components/TOC.astro';

export interface Props {
  metadata: {
    title: string;
    description: string;
    ogImage?: string;
    slug?: string;
  };
  data: {
    headline: string;
    subline?: string;
    cover?: string;
    alt?: string;
    plantedDate: string;
    lastTendedDate: string;
    minRead: number;
    type?: string;
    subtype?: string;
    tags?: string[];
    subheadings?: { depth: number; text: string; slug: string }[];
  };
}

const { metadata, data } = Astro.props;
const { headline, subline, cover, alt, plantedDate, lastTendedDate, minRead, type, subtype, tags = [], subheadings = [] } = data;
const src = "https://assets.ysabella.me/cdn-cgi/image/format=webp,quality=100,width=1200/garden";
---
<Layout {...metadata} classes="scroll" activeTab="garden">
  {subheadings.length > 0 && (
    <TOC subheadings={subheadings} />
  )}
  <LinkButton type="back" href="/writing" aria-label="Back" class="back-link floating hide-on-idle">
    <ArrowLeftIcon />
  </LinkButton>
  <LinkButton  aria-label="Scroll to top" class="scroll-top floating">
    <ArrowUpIcon />
  </LinkButton>
  <article class="text">
    {cover && (
      <figure>
        <img class="wide" src=`${src}/${cover}` alt={alt} decoding="async" loading="lazy"/>
      </figure>
    )}
    <header class="column content">
      <dl class="metadata row">
        {plantedDate && (
          <dl class="datapoint row">
            <dt class="item">Planted</dt>
            <dd class="small item emphasis">
              <time datetime={plantedDate}>
                {new Date(plantedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </dd>
          </dl>
        )}
        {lastTendedDate && (
          <span class="divider flex" aria-hidden="true" />
          <dl class="datapoint row">
            <dt class="item">Last Tended</dt>
            <dd class="small item emphasis">
              <time datetime={lastTendedDate}>
                {new Date(lastTendedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </dd>
          </dl>
        )}
        <span class="divider flex" aria-hidden="true" />
        <dl class="datapoint row">
          <dt class="item">Read Time</dt>
          <dd class="small item emphasis">{minRead} min</dd>
        </dl>
        </div> 
      </dl>
      <div class="column content xs">
        <h1>{headline}</h1>
        {subline && (
          <p class="subline">{subline}</p>
        )}
      </div>
    </header>
    <div class="column content garden">
      <slot />
    </div>
    <span class="divider stretch" aria-hidden="true" />
    <div class="row stretch apart">
      <dl class="datapoint row">
        <dt class="item">Filed under</dt>
        <dd><a class="small item emphasis" href={`/tags/${subtype || type || "notes"}`}>#{subtype || type || "notes"}</a></dd>
        {tags.map((tag) => (
        <dd><a class="small item emphasis" href={`/tags/${tag}`}>#{tag}</a></dd>
      ))}
      </dl>
    </div>
  </article>
</Layout>

<style is:global>
  .content h2 {
    color: var(--color-foreground-300);
    font-family: var(--font-mono);
    font-size: var(--size-type-caption);
    text-transform: uppercase;
    letter-spacing: 8%;
  }

  .content h2:not(.callout-title h2) {
    margin-top: var(--size-padding-sm);
  }

  .content h3 {
    font-size: var(--size-heading-md);
  }
  
  .content img {
    max-height: 30rem;
    width: 100%;
  }
</style>

<script>
  /* Hide floating elements when idle */
  let scrollTimeout: ReturnType<typeof setTimeout>;
  const idleElements = document.querySelectorAll<HTMLElement>('.hide-on-idle');
  const TOC = document.querySelector('#toc details') as HTMLDetailsElement | null;

  if (idleElements.length > 0) {
    const showAndReset = () => {
      idleElements.forEach(el => el.classList.add('visible'));
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        if (TOC?.open) return; // Don't hide if TOC is open
        idleElements.forEach(el => el.classList.remove('visible'));
      }, 1500);
    };

    ['scroll'].forEach(event => {
      window.addEventListener(event, showAndReset);
    });
  }
</script>