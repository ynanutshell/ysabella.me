---
import '../styles/global.css';
import ArrowLeftIcon from '../components/icons/ArrowLeft.astro';
import ArrowUpIcon from '../components/icons/ArrowUp.astro';
import Layout from '../layouts/BaseLayout.astro';
import LinkButton from '../components/LinkButton.astro';
import Lottie from '../components/Lottie.astro';
import TOC from '../components/TOC.astro';

interface DetailItem {
  label: string;
  value: string | string[];
}

type Cover = 
  | { type: 'image'; src: string; alt?: string }
  | { type: 'video'; src: string; alt?: string }
  | { type: 'lottie'; src: string; alt?: string; loop?: boolean; autoplay?: boolean };

export interface Props {
  metadata: {
    title: string;
    description: string;
    ogImage?: string;
  };
  data: {
    status: 'shipped' | 'roadmap' | 'development';
    headline: string;
    subline?: string;
    cover?: Cover;
    preview?: string;
    caption?: string;
    href?: string;
    details?: DetailItem[];
    subheadings?: { depth: number; text: string; slug: string }[];
  };
}

const { metadata, data } = Astro.props;
const { headline, subline, cover, preview, caption, href, details = [], subheadings = [] } = data;
---
<Layout {...metadata} activeTab="work">
  <article class="text">
    {subheadings.length > 0 && (
      <TOC subheadings={subheadings} />
    )}
    <LinkButton type="back" href="/#work" aria-label="Back" class="back-link floating hide-on-idle">
      <ArrowLeftIcon />
    </LinkButton>
    <header class="column md">
      <div class="column content">
        <div class="status">
          <span class=`indicator ${data.status}` />
          <span class="caption label">
            {data.status === 'shipped'  && ('shipped')}
            {data.status === 'development' && ('in development')}
            {data.status === 'roadmap' && ('on the roadmap')}
          </span>
        </div>
        <h1>{headline}</h1>
        <p class="subline">{subline}</p>
      </div>
      {details.length > 0 && (
        <dl class="metadata">
          {details.map(item => (
            <div class="datapoint">
              <dt>{item.label}</dt>
              <dd class="item">
                {Array.isArray(item.value) 
                  ? item.value.map((v, i) => (
                      <p class="item">
                        {v}
                      </p>
                    ))
                  : item.value
                }
              </dd>
            </div>
          ))}
        </dl>
      )}
      {cover && (
        <figure>
          {cover.type === 'lottie' && (
            <Lottie 
              src={cover.src}
              loop={cover.loop ?? true}
              autoplay={cover.autoplay ?? true}
              aria-label={cover.alt || null}
              class="wide"
            />
          )}
          {cover.type === 'video' && (
            <video src={cover.src} aria-label={cover.alt || null} class="wide" autoplay muted loop playsinline poster={preview} />
          )}
          {cover.type === 'image' && (
            <img src={cover.src} alt={cover.alt || null} class="wide" />
          )}
          {caption && (
            <figcaption class="caption label">
              {href ? (
                <a href={href} target="_blank" class="caption label">{caption}</a>
              ) : {caption} }
            </figcaption>
          )}
        </figure>
      )}
    </header>
    <div class="column content lg">
      <slot />
    </div>
    <LinkButton  aria-label="Scroll to top" class="scroll-top floating">
      <ArrowUpIcon />
    </LinkButton>
  </article>
</Layout>

<script>
  /* Hide floating elements when idle */
  let scrollTimeout: ReturnType<typeof setTimeout>;
  const idleElements = document.querySelectorAll<HTMLElement>('.hide-on-idle');
  const TOC = document.querySelector('#toc details') as HTMLDetailsElement | null;

  if (idleElements.length > 0) {
    const showAndReset = () => {
      idleElements.forEach(el => el.classList.add('visible'));
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        if (TOC?.open) return; // Don't hide if TOC is open
        idleElements.forEach(el => el.classList.remove('visible'));
      }, 1500);
    };

    ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'].forEach(event => {
      window.addEventListener(event, showAndReset);
    });
  }

  /* Table of contents */
  const tocLinks = document.querySelectorAll('.toc a');
  if (tocLinks.length > 0) {
    const headings = document.querySelectorAll('h2[id], h3[id]');
    window.addEventListener('scroll', () => {
      let current = '';
      headings.forEach(h => {
        if (h.getBoundingClientRect().top <= 100) current = h.id;
      });
      tocLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
      });
    });
  }

  /* Back link */
  const backLink = document.querySelector('[data-back-link]');
  if (backLink && document.referrer) {
    backLink.setAttribute('href', document.referrer);
    console.log(document.referrer);
  }

  /* Scroll to top */
  const scrollTopBtn = document.querySelector('.scroll-top');

  if (scrollTopBtn) {
    const footer = document.querySelector('footer');

    window.addEventListener('scroll', () => {
      const bottom = footer
        ? window.scrollY + window.innerHeight >= footer.offsetTop - 10 : false;

      scrollTopBtn.classList.toggle('visible', window.scrollY > 10 && !bottom);
    });
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
