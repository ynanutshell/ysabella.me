---
import '../styles/global.css';
import Layout from '../layouts/BaseLayout.astro';
import LinkButton from '../components/LinkButton.astro';
import Lottie from '../components/Lottie.astro';
import TOC from '../components/TOC.astro';

interface DetailItem {
  label: string;
  value: string | string[];
}

type Cover = 
  | { type: 'image'; src: string; alt?: string }
  | { type: 'video'; src: string; alt?: string }
  | { type: 'lottie'; src: string; alt?: string; loop?: boolean; autoplay?: boolean };

export interface Props {
  metadata: {
    title: string;
    description: string;
    ogImage?: string;
  };
  data: {
    status: 'shipped' | 'roadmap' | 'development';
    headline: string;
    subline?: string;
    cover?: Cover;
    preview?: string;
    caption?: string;
    href?: string;
    details?: DetailItem[];
    subheadings?: { depth: number; text: string; slug: string }[];
  };
}

const { metadata, data } = Astro.props;
const { headline, subline, cover, preview, caption, href, details = [], subheadings = [] } = data;
---
<Layout {...metadata} activeTab="work">
  <article class="text">
    <nav id="top-nav">
      <LinkButton class="backlink" href="/#work">
        <svg class="arrow-left" width="9" height="7" viewBox="0 0 9 7" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.70715 3.35352H0.707153M3.70715 6.35352L0.707153 3.35352L3.70715 0.353516" stroke="#7D89B0"/>
        </svg>
        <span>back to work</span>
      </LinkButton>
      {subheadings.length > 0 && (
        <TOC subheadings={subheadings} />
      )}
    </nav>
    <header class="column md">
      <div class="column content">
        <div class="status">
          <span class=`indicator ${data.status}` />
          <span class="caption label">
            {data.status === 'shipped'  && ('shipped')}
            {data.status === 'development' && ('in development')}
            {data.status === 'roadmap' && ('on the roadmap')}
          </span>
        </div>
        <h1>{headline}</h1>
        <p class="subline">{subline}</p>
      </div>
      {details.length > 0 && (
        <dl class="metadata">
          {details.map(item => (
            <div class="datapoint">
              <dt>{item.label}</dt>
              <dd class="item">
                {Array.isArray(item.value) 
                  ? item.value.map((v, i) => (
                      <p class="item">
                        {v}
                      </p>
                    ))
                  : item.value
                }
              </dd>
            </div>
          ))}
        </dl>
      )}
      {cover && (
        <figure>
          {cover.type === 'lottie' && (
            <Lottie 
              src={cover.src}
              loop={cover.loop ?? true}
              autoplay={cover.autoplay ?? true}
              aria-label={cover.alt || null}
              class="wide"
            />
          )}
          {cover.type === 'video' && (
            <video src={cover.src} aria-label={cover.alt || null} class="wide" autoplay muted loop playsinline poster={preview} />
          )}
          {cover.type === 'image' && (
            <img src={cover.src} alt={cover.alt || null} class="wide" />
          )}
          {caption && (
            <figcaption class="caption label">
              {href ? (
                <a href={href} target="_blank" class="caption label">{caption}</a>
              ) : {caption} }
            </figcaption>
          )}
        </figure>
      )}
    </header>
    <div class="column content lg">
      <slot />
    </div>
  </article>
</Layout>

<script>
  const scrollTopBtn = document.querySelector('.scroll-top');
  if (scrollTopBtn) {
    window.addEventListener('scroll', () => {
      scrollTopBtn.classList.toggle('visible', window.scrollY > 300);
    });
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  const tocLinks = document.querySelectorAll('.toc a');
  if (tocLinks.length > 0) {
    const headings = document.querySelectorAll('h2[id], h3[id]');
    window.addEventListener('scroll', () => {
      let current = '';
      headings.forEach(h => {
        if (h.getBoundingClientRect().top <= 100) current = h.id;
      });
      tocLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
      });
    });
  }
</script>