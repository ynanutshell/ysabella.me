---
interface Props {
  entries: any[];
  limit?: number | false;
}

const { entries, limit = false } = Astro.props;

const sorted = [...entries]
  .sort((a, b) => new Date(b.data.planted || 0).getTime() - new Date(a.data.planted || 0).getTime());

const displayed = limit === false ? sorted : sorted.slice(0, limit);
---
<ol class="list" reversed style={`--total: ${displayed.length}`}>
  {displayed.map(entry => (
  <li class="bookmark caption label stretch">
    <div class="item row stretch">
      <div class="caption label">
        <h3 class="link"><a href={entry.data.url || `/bookmarks/${entry.id}`} target="_blank">{entry.data.title}</a></h3>
        {entry.data.via && (
          <>
            <span>via</span>
            <a class="emphasis u-bookmark-of" href={entry.data.source} target="_blank">{entry.data.via}</a>
          </>
        )}
      </div>
      <span class="divider stretch" aria-hidden="true" />
      <span class="caption label">{entry.data.subtype}</span>
    </div>
  </li>
  ))}
</ol>

<style is:global>
  .list {
    counter-reset: bookmark calc(var(--total) + 1);
    list-style: none;
    margin: unset;
  }

  .bookmark {
    counter-increment: bookmark -1;
    margin-left: unset;

    div {
      margin-left: unset;
    }
  }

  .bookmark::before {
    content: "#" counter(bookmark) " ";
  }

  .link {
    display: inline;
    text-transform: none;
    letter-spacing: 0;
  }
</style>