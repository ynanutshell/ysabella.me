---
interface Props {
  entries: any[];
  limit?: number | false;
}

const { entries, limit = false } = Astro.props;

const displayed = limit === false ? entries : entries.slice(0, limit);
---
<ol style={`--total: ${displayed.length}`}>
  {displayed.map(entry => (
  <li class="stretch">
    <div class="item row">
      <div class="caption label">
        <h3 class="link"><a href={entry.data.url || `/bookmarks/${entry.id}`} target="_blank">{entry.data.title}</a></h3>
        {entry.data.via && (
          <>
            <span>via</span>
            <a class="emphasis u-bookmark-of" href={entry.data.source} target="_blank">{entry.data.via}</a>
          </>
        )}
      </div>
      <span class="divider stretch" aria-hidden="true" />
      <span class="caption label">{entry.data.subtype}</span>
    </div>
  </li>
  ))}
</ol>

<style is:global>
  ol {
    counter-reset: bookmark calc(var(--total) + 1);

    li {
      margin-left: unset;
      counter-increment: bookmark -1;

      div {
        margin-left: var(--size-padding-2xs);
      }
    }

    li::marker {
      content: counter(bookmark, decimal-leading-zero) " ";
    }
  }

  .link {
    display: inline;
    text-transform: none;
    letter-spacing: 0;
  }
</style>