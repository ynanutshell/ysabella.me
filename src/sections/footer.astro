---
import { getCommit } from '../utils/commit';
import Navbar from '../components/NavigationBar.astro';
import SmallCard from "../components/SmallCard.astro";

const commit = await getCommit();
const src = "https://assets.ysabella.me/cdn-cgi/image/format=webp,quality=100,width=500";

const { activeTab } = Astro.props;
---
<Navbar activeTab={activeTab} classes="footer" />
<footer>
  <div class="container">
    <p class="caption">designed and built with a lot of overthinking and late nights</p>
    <SmallCard id="mail" background="white" linkText="hello@ysabella.me" href="mailto:hello@ysabella.me">
      say hello!
    </SmallCard>
    <SmallCard id="linkedin" background="white" linkText="/in/ysabellanicole" href="https://www.linkedin.com/in/ysabellanicole">
      connect with me
    </SmallCard>
    <figure class="portrait">
      <img src=`${src}/portrait.jpeg` alt="Portrait shot of Ysabella Nicole Alvarez" loading="lazy" />
    </figure>
  </div>
  <div id="additional">
    <small id="copyright" class="row left">&copy; 2026 Ysabella Nicole Alvarez</small>
    <div id="socials" class="row middle">
      <a class="social" href="https://sunny.garden/@ysabella" aria-label="Link to Mastodon" rel="me" target="_blank">
