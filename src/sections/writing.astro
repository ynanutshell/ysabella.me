---
interface Props {
  entries: any[];
  limit?: number | false;
}

const { entries, limit = 4 } = Astro.props;

const sorted = [...entries]
  .sort((a, b) => (b.data.planted?.getTime() ?? 0) - (a.data.planted?.getTime() ?? 0));

const displayed = limit === false ? sorted : sorted.slice(0, limit);

const clean = (text: string) => 
  text
    ?.replace(/^#{1,6}\s.*$/gm, '')
    .replace(/\[\[([^\]]+)\]\]/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*`>|-]/g, '')
    .split('\n')
    .filter(l => l.trim())
    .join(' ') || '';
---
<div class="column">
  {displayed.map(entry => (
    <a class="noborder card lg" href={`/writing/${(entry.data.slug || entry.id).toLowerCase()}`}>
      {entry.data.image && (
        <img 
          src={entry.data.image} 
          alt="" 
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="column content xs">
        <div class="metadata row">
          <dd class="item">
            <time class="small">{entry.data.planted?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </dd>
          <span class="divider" />
          <dd class="small">{Math.max(1, Math.ceil((entry.body?.split(/\s+/).filter(Boolean).length ?? 0) / 130))} min read</dd>
          <span class="divider" />
          <dd class="small">{entry.data.subtype || entry.data.type || 'Notes'}</dd>
          {entry.data.tags > 0 && (
            <span class="divider" />
            <dd class="small">{entry.data.tags[0]}</dd>
          )}
        </div>
        <div class="description">
          <h3>{entry.data.title}</h3>
          {(entry.data.description || entry.body) && (
            <p class="subline">{clean(entry.data.description || entry.body)}</p>
          )}
        </div>
      </div>
    </a>
  ))}
</div>

<style>
  .card {
    .description {
      display: flex;
      flex-direction: column;
    }

    p {
      overflow: hidden;
      display: -webkit-inline-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }

  .card:hover {
    background-color: var(--color-background-300);
  }
</style>