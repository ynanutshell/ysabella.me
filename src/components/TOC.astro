---
import Dropdown from './Dropdown.astro';

interface Subheading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  subheadings: Subheading[];
}

const { subheadings } = Astro.props;
---

{subheadings.length > 0 && (
  <Dropdown id="toc" class="hide-on-idle" label="contents">
    <ul>
      {subheadings.map((subheading, i) => (
        <li class="dropdown item">
          <a aria-label={subheading.text} class={`row stretch apart depth-${subheading.depth}`} href={`#${subheading.slug.replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-')}`}>
            {subheading.text.toLowerCase().replace('.', '')}
          </a>
        </li>
      ))}
    </ul>
  </Dropdown>
)}

<style>
  .dropdown.item a.depth-3 { 
    padding-left: calc(var(--size-padding-md) * 2); 
  }
  
  .dropdown.item a.depth-4 {
    padding-left: calc(var(--size-padding-md) * 3); 
  }
</style>

<script>
  const tocLinks = document.querySelectorAll('#toc .dropdown.item a');
  const sections = document.querySelectorAll('section[id]');
  const details = document.querySelector('#toc details') as HTMLDetailsElement | null;

  document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const hash = link.getAttribute('href') || '';
      const target = document.querySelector(hash);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', hash);
      }
    });
  });

  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(section => {
      if (section.getBoundingClientRect().top <= 300) {
        current = section.id;
      }
    });
    tocLinks.forEach(link => {
      link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
    });
  });

  if (details) {
    details.open = window.matchMedia('(min-width: 1200px)').matches;
  }

  if (tocLinks.length > 0) {
    const headings = document.querySelectorAll('h2[id], h3[id]');
    window.addEventListener('scroll', () => {
      let current = '';
      headings.forEach(h => {
        if (h.getBoundingClientRect().top <= 100) current = h.id;
      });
      tocLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
      });
    });
  }
</script>