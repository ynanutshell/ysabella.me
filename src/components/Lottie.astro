---
export interface Props {
  src: string;
  loop?: boolean;
  autoplay?: boolean;
  class?: string;
  style?: string;
}

const { src, loop = true, autoplay = true, class: className, style } = Astro.props;
const id = 'lottie-' + Math.random().toString(36).slice(2, 8);
---

<div id={id} class={className} style={style} data-lottie-src={src} data-lottie-loop={loop} data-lottie-autoplay={autoplay}></div>

<script>
  import lottie from 'lottie-web';

  function init() {
    document.querySelectorAll<HTMLDivElement>('[data-lottie-src]:not([data-lottie-loaded])').forEach(el => {
      el.setAttribute('data-lottie-loaded', 'true');
      lottie.loadAnimation({
        container: el,
        renderer: 'svg',
        loop: el.dataset.lottieLoop !== 'false',
        autoplay: el.dataset.lottieAutoplay !== 'false',
        path: el.dataset.lottieSrc,
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>