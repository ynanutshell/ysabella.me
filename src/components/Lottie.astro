---
interface Props {
  src: string;
  class?: string;
  autoplay?: boolean;
  loop?: boolean;
}

const { src, class: className, autoplay = true, loop = true } = Astro.props;
---
<div
  class={`lottie-container ${className ?? ''}`}
  data-src={src}
  data-autoplay={String(autoplay)}
  data-loop={String(loop)}
></div>

<script>
  const lottieScript = document.createElement('script');
  lottieScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js';
  
  function getLottieSrc(baseSrc: string = '') {
    const darkMode = getComputedStyle(document.documentElement).colorScheme === 'dark';
    if (!darkMode) return baseSrc;
    return baseSrc.replace('.json', '-dark.json');
  }

  async function initLottie() {
  const containers = document.querySelectorAll<HTMLElement>('.lottie-container');
  for (const container of containers) {
    const existing = (window as any).lottie?.getRegisteredAnimations?.()?.find(
      (a: any) => a.wrapper === container
    );
    if (existing) existing.destroy();

    let src = getLottieSrc(container.dataset.src);
    (window as any).lottie.loadAnimation({
      container,
      renderer: 'svg',
      loop: container.dataset.loop === 'true',
      autoplay: container.dataset.autoplay === 'true',
      path: src,
    });
  }
}

lottieScript.onload = initLottie;
document.head.appendChild(lottieScript);

const observer = new MutationObserver(initLottie);
observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
window.addEventListener('themechange', initLottie);
</script>