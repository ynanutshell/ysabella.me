---
interface Props {
  src: string;
  darkSrc?: string;
  class?: string;
  autoplay?: boolean;
  loop?: boolean;
}

const { src, darkSrc, class: className, autoplay = true, loop = true } = Astro.props;
---
<div
  class={`lottie-container ${className ?? ''}`}
  data-src={src}
  data-src-dark={darkSrc || null}
  data-autoplay={String(autoplay)}
  data-loop={String(loop)}
></div>

<script>
  const lottieScript = document.createElement('script');
  lottieScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js';
  
  function getLottieSrc(baseSrc: string = '', darkSrc: string = '') {
    const darkMode = getComputedStyle(document.documentElement).colorScheme === 'dark';
    return darkMode && darkSrc ? darkSrc : baseSrc;
  }

  function initAllLotties() {
    document.querySelectorAll<HTMLElement>('.lottie-container').forEach(container => {
      container.innerHTML = '';
      const src = getLottieSrc(container.dataset.src, container.dataset.srcDark);
      (window as any).lottie.loadAnimation({
        container,
        renderer: 'svg',
        loop: container.dataset.loop === 'true',
        autoplay: container.dataset.autoplay === 'true',
        path: src,
      });
    });
  }

  lottieScript.onload = () => {
    initAllLotties();
    window.addEventListener('themechange', initAllLotties);
  };

  document.head.appendChild(lottieScript);
</script>