---
import Lottie from '../components/Lottie.astro';

type Visual = 
  | { type: 'image'; src: string; alt?: string }
  | { type: 'video'; src: string; preview?: string; alt?: string }
  | { type: 'html'; html: string; classes?: string }
  | { type: 'lottie'; src: string; alt?: string; loop?: boolean; autoplay?: boolean };

interface Props {
  cards: {
    title: string;
    href?: string;
    target?: string;
    visual: Visual;
    background?: string;
    tags?: string[];
    fit?: string;
    colSpan: number;
    rowSpan: number;
  }[];
  filter?: string;
}

const { cards, filter } = Astro.props;
const filtered = filter 
  ? cards.filter(card => card.tags?.some(tag => tag.toLowerCase().includes(filter.toLowerCase())))
  : cards;
---
<div id="grid" class="container">
  {filtered.map((card) => {
    const isLink = !!card.href;
    const CardWrapper = isLink ? 'a' : 'div';
    
    return (
      <CardWrapper 
        data-tags={card.tags?.join(',')}
        href={isLink ? card.href : undefined}
        target={isLink ? card.target : undefined}
        class={`card grid ${card.fit || 'cover'}`}
        style={[
          `grid-column: span ${card.colSpan}`,
          `grid-row: span ${card.rowSpan}`,
          card.background ? `background: ${card.background}` : ''
        ].filter(Boolean).join('; ')}
      >
        {card.fit !== 'phone' && card.fit !== 'contain' && (
          <>
            {card.visual.type == 'image' ? (
              <img src={card.visual.src} alt={card.visual.alt || null} decoding="async" loading="lazy" />
            ) : 
            card.visual.type == 'video' ? (
              <video src={card.visual.src} aria-label={card.visual.alt || null} poster={card.visual.preview} autoplay muted loop playsinline />
            ) : 
            card.visual.type == 'lottie' ? (
              <Lottie 
                src={card.visual.src}
                loop={card.visual.loop ?? true}
                autoplay={card.visual.autoplay ?? true}
                aria-label={card.visual.alt || null}
              />
            ) :
            card.visual.type == 'html' ? (
              <>
                <div class={`${card.visual.classes || ''}`} set:html={card.visual.html} />
              </>
            ) : null}
          </>
        )}
        {card.fit === 'contain' && (
          <div class="contained">
            {card.visual.type === 'image' ? (
              <img src={card.visual.src} alt={card.visual.alt || null} decoding="async" loading="lazy" />
            ) : 
            card.visual.type === 'video' ? (
              <video src={card.visual.src} aria-label={card.visual.alt || null} poster={card.visual.preview} autoplay muted loop playsinline />
            ) : 
            card.visual.type === 'lottie' ? (
              <Lottie 
                src={card.visual.src}
                loop={card.visual.loop ?? true}
                autoplay={card.visual.autoplay ?? true}
                aria-label={card.visual.alt || null}
              />
            ) :
            card.visual.type === 'html' ? (
              <>
                <div class={`${card.visual.classes || ''}`} set:html={card.visual.html} />
              </>
            ) : null}
          </div>
        )}
        {card.fit === 'horizontal' && (
          <div class="horizontal">
            {card.visual.type === 'image' ? (
              <img src={card.visual.src} alt={card.visual.alt || null} decoding="async" loading="lazy" />
            ) : 
            card.visual.type === 'video' ? (
              <video src={card.visual.src} aria-label={card.visual.alt || null} poster={card.visual.preview} autoplay muted loop playsinline />
            ) : 
            card.visual.type === 'lottie' ? (
              <Lottie 
                src={card.visual.src}
                loop={card.visual.loop ?? true}
                autoplay={card.visual.autoplay ?? true}
                aria-label={card.visual.alt || null}
              />
            ) :
            card.visual.type === 'html' ? (
              <>
                <div class={`${card.visual.classes || ''}`} set:html={card.visual.html} />
              </>
            ) : null}
          </div>
        )}
        {card.fit === 'phone' && (
          <figure class="mockup">
            {card.visual.type === 'image' ? (
              <img src={card.visual.src} alt={card.visual.alt || null} class="screen" decoding="async" loading="lazy" />
            ) : 
            card.visual.type === 'video' ? (
              <video src={card.visual.src} aria-label={card.visual.alt || null} poster={card.visual.preview} class="screen" autoplay muted loop playsinline />
            ) : 
            card.visual.type === 'lottie' ? (
              <Lottie 
                src={card.visual.src}
                loop={card.visual.loop ?? true}
                autoplay={card.visual.autoplay ?? true}
                aria-label={card.visual.alt || null}
                class="screen"
              />
            ) :
            card.visual.type === 'html' ? (
              <>
                <div class={`screen ${card.visual.classes || ''}`} set:html={card.visual.html} />
              </>
            ) : null}
          </figure>
        )}
      </CardWrapper>
    );
  })}
</div>

<style>
  #grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    grid-auto-rows: auto;
    gap: var(--size-padding-lg);
  }
  
  @media (max-width: 1200px) {
    #grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    #grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>