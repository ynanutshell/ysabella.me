---
interface Props {
  activeTab?: string;
  classes: string;
}

const { activeTab, classes } = Astro.props;

const tabs = [
  { href: "/", label: "work" },
  { href: "/garden", label: "garden" },
  { href: "/about", label: "about" },
  { href: "mailto:hello@ysabella.me", label: "contact" },
  // { href: "/more", label: "..." },
];
---
<nav aria-label="Site Menu" id="navbar" class={classes} >
  {tabs.map((tab) => (
    <a 
      class={`noborder tab ${activeTab === tab.label ? 'active' : ''}`}
      href={tab.href}
      data-tab={tab.label}
    >
      {tab.label}
    </a>
  ))}
</nav>