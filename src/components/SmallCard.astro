---
type Props = {
  background?: "primary" | "secondary" | "white" | "green" | "yellow" | "purple" | "pink" | "magenta";
  linkText?: string;
  href?: string;
  id?: string;
};

const { 
  background = "primary",
  linkText,
  href,
  id
} = Astro.props;
---
<aside 
  id={id}
  class={[
    "accent card lg",
    background,
  ].filter(Boolean).join(" ")}
>
  <p class="caption">
    <slot />
    {linkText && (
      <>
      <br />
      {href ? (
        <a href={href} target="_blank"  >
          {linkText}
        </a>
      ) : (
        linkText
      )}
      </>
    )}
  </p>
</aside>